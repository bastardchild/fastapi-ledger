# Python virtual environment — never commit, must be created locally
venv/
.venv/
env/
ENV/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Test & tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.tox/

# Distribution / build output (created by `pip install .` from pyproject.toml)
build/
dist/
*.egg-info/
.eggs/
wheels/
*.whl
__pypackages__/

# SQLite ledger database — runtime data, never commit
ledger.db
ledger.db-journal
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Server-generated runtime files (created by deploy.sh, never commit)
.htaccess
ledger.log
ledger.log.*

# Python version managers
.python-version

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# Logs and local scratch files
*.log
*.tmp
*.bak
*.orig

# Generated QR / test artifacts
*.png

# Built distribution archives
*.zip
